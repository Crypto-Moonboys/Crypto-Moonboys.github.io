  "claim_rules": [
    {
      "id": "triple-fork-date",
      "pattern": "\\b(?:Triple Fork|Chainfire)\\b(?:(?!\\d{4}|[,;]).){0,85}?\\b(?:occurred|happened|began|erupted|event was|dates? to|in the year|in)\\s+(?<year>\\d{4})\\b",
      "denial": "\\b(?:not|never)\\b.{0,45}\\b(?:2198|2588)\\b",
      "locked_anchor": "world_chain_triple_fork"
    },
    {
      "id": "early-triple-fork",
      "pattern": "\\b(?:In|Year)\\s+(?<year>\\d{4})\\b.{0,65}\\b(?:Triple Fork|Chainfire)\\b.{0,35}\\b(?:occurred|happened|began|erupted|destroyed|fractured)\\b",
      "locked_anchor": "world_chain_triple_fork"
    },
    {
      "id": "closed-final-fork",
      "pattern": "\\bFinal Fork\\b\\s+(?:has\\s+|is\\s+|was\\s+|had\\s+)?(?:already\\s+)?(?:concluded|completed|resolved|won|ended|settled)\\b",
      "denial": "\\bFinal Fork\\b\\s+(?:has\\s+|is\\s+|was\\s+)?(?:not|never)\\b"
    },
    {
      "id": "kids-identity-merge",
      "pattern": "\\bBitcoin (?:X )?Kids\\b\\s+(?:are|is)\\s+(?:the same (?:as|people as)|(?:also )?(?:known as|identical to|another name for))\\s+(?:the\\s+)?Bitcoin (?:X )?Kids\\b"
    },
    {
      "id": "hodl-identity-merge",
      "pattern": "\\bHODL (?:X )?Warriors\\b\\s+(?:are|is)\\s+(?:the same (?:as|people as)|(?:also )?(?:known as|identical to|another name for))\\s+(?:the\\s+)?HODL (?:X )?Warriors\\b"
    },
    {
      "id": "chain-identity-merge",
      "pattern": "\\b(?:Sacred(?:/Aether)?[- ]Chain|Aether[- ]Chain)\\b\\s+(?:is|was)\\s+(?:(?:also )?(?:known as|identical to|another name for)|the same as)\\s+(?:the\\s+)?(?:World Chain|True Bitcoin Fork)\\b"
    },
    {
      "id": "archival-game-live-claim",
      "pattern": "\\b(?:BLOCKFRONT|DREAMWARS|FORKLORDS)\\b\\s+(?:is|are|has)\\s+(?:now\\s+)?(?:live|launched|available to play|paying|released)\\b"
    },
    {
      "id": "concord-reset-merge",
      "pattern": "\\bGreat Concord\\b\\s+(?:of 2030\\s+|in 2030\\s+)?(?:is|was)\\s+(?:the\\s+)?(?:2030\\s+)?Reset\\b"
    },
    {
      "id": "sam-runtime-merge",
      "pattern": "\\b(?:Samuel (?:[\u201c\"]?HyroSAM[\u201d\"]? )?Blake|HyroSAM Blake)\\b\\s+(?:is|was)\\s+(?:the\\s+)?(?:deployed SAM|SWARMSY SPARKY)\\b"
    },
    {
      "id": "sacred-fork-open-date",
      "pattern": "\\bSacred Fork\\b\\s+(?:occurred|happened|began)\\s+in\\s+\\d{4}\\b"
    },
    {
      "id": "early-regional-collapse",
      "pattern": "\\bBy\\s+2765\\s+(?:fewer|less)\\s+than\\s+(?:a\\s+)?dozen\\s+secure\\s+regions\\s+remained\\b"
    }
  ]
