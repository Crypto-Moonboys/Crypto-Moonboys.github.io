{
  "name": "crypto-moonboys.github.io",
  "version": "1.0.0",
  "description": "Crypto Moonboys is the live website for the project, including the arcade and shared frontend support assets.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run ci:arcade && npm run ci:worker-api && npm run ci:wiki && npm run ci:wax && npm run ci:visual",
    "ci:wiki": "node scripts/ci-domain-runner.mjs wiki",
    "ci:worker-api": "node scripts/ci-domain-runner.mjs worker-api",
    "ci:arcade": "node scripts/ci-domain-runner.mjs arcade",
    "ci:wax": "node scripts/ci-domain-runner.mjs wax",
    "ci:visual": "node scripts/ci-domain-runner.mjs visual",
    "test:full": "npm run test",
    "test:anti-drift": "node scripts/anti-drift-check.mjs",
    "test:shell-parity": "node scripts/site-shell-parity-audit.mjs",
    "daily-loop:checklist": "node scripts/daily-loop-post-merge-checklist.mjs",
    "lint:shell": "node --check js/site-shell.js",
    "test:live-site": "node scripts/live-site-verify.mjs",
    "test:live-content": "node scripts/live-content-truth-verify.mjs",
    "deploy:status": "node scripts/pages-deploy-status.mjs",
    "btqm:assets:dry": "node scripts/generate-btqm-assets.mjs",
    "btqm:assets": "node scripts/generate-btqm-assets.mjs",
    "test:btqm-runtime-assets": "node scripts/btqm-runtime-assets-smoke.test.mjs",
    "btqm:assets:hydrate": "node scripts/hydrate-btqm-generated-assets.mjs",
    "invaders:ship:hydrate": "node scripts/hydrate-invaders-player-ship.mjs",
    "test:invaders-ship": "npm run invaders:ship:hydrate && node scripts/invaders-player-ship-asset.test.mjs",
    "test:wiki-structure": "node wiki/validators/wiki-structure-check.js",
    "test:nbg-level1": "node scripts/nbg-level1-browser-validation.mjs --serve",
    "avatar:assets": "node scripts/build-avatar-assets.mjs",
    "test:avatar-builder": "node scripts/avatar-builder-assets.test.mjs && node scripts/avatar-builder-browser.test.mjs",
    "moonpet:art:check": "node scripts/moonpet-art-architecture.test.mjs",
    "moonpet:multi-bot:test": "node scripts/moonpet-multi-bot-art.test.mjs",
    "moonpet:extract:test": "node scripts/generate-moonpet-assets-extraction.test.js",
    "moonpet:autosprite:discover": "node scripts/discover-autosprite-character.js",
    "moonpet:front:generate": "node scripts/generate-botty-front-animations.js",
    "moonpet:front:download": "node scripts/download-botty-front-animations.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "sharp": "^0.35.2",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "@pixellab-code/pixellab": "^1.0.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1"
  }
}
