    "rule": "Mirror-safe traits may follow the sprite mirror transform. Directional traits must define left/right hand or side-specific anchors before they can render on mirrored roles."
  },
  "pose_adaptation_policy": {
    "master_mannequin": "Design every trait first on side_front_point.",
    "propagation_rule": "Adapt the same item to each active runtime sheet; do not create pose-specific clothing designs.",
    "adaptation_steps": [
      "Keep the same visual item identity, colors, materials, and silhouette language.",
      "Resize and reposition the item to the destination pose anchor.",
      "Adjust rotation for body angle, facing direction, and limb position.",
      "Use simplified placement for quick or rare poses when necessary.",
      "Require stronger consistency on common/core poses than rare personality poses."
    ],
    "quality_floor": {
      "core_roles": [
        "side_front_point",
        "side_front_wave",
        "side_idle",
        "side_walk",
        "side_run"
      ],
      "rare_roles": [
        "side_front_victory",
        "side_front_dance"
      ],
      "small_pose_policy": "If a rare pose reads smaller, try runtime scale normalization first. If quality suffers, keep it rare-only and regenerate later only if consistency breaks."
    }
  },
  "anchor_schema": {
    "coordinate_space": "normalized_frame",
    "origin": "top_left",
    "fields": {
      "x": "0..1 center x inside the current sprite frame",
      "y": "0..1 center y inside the current sprite frame",
      "scale": "relative scale multiplier for the trait artwork on this role",
      "rotation": "degrees clockwise from the master trait orientation",
      "quality": "core, adapted, or simplified",
      "mirror_safe": "whether the placement may use the sprite mirror transform"
    }
  },
